# backend/.env
DB_USER=user
DB_HOST=localhost
DB_NAME=portfolio_db
DB_PASSWORD=password
DB_PORT=5432
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
BINANCE_API_KEY=your_binance_key
BINANCE_SECRET=your_binance_secret

# Paper day-trading (no Robinhood keys — live is out of band via MCP)
DAYTRADE_UNIVERSE=SOFI,BRK.B,TSLA,AMZN,ARKK,MSFT,NVDA,PLTR
# RH Agentic research budget (separate book). Alpaca paper uses sleeves below.
PAPER_CASH=100
# Alpaca paper capital: ~400k buying power as four ~100k sleeves.
# Intraday is active for paper:daily. multi-day / crypto / options stay parked.
PAPER_SLEEVE_EQUITY=100000
# Risk per trade as a fraction of active sleeve equity. Clamped to 1–2%.
PAPER_SLEEVE_RISK_PCT=0.01
# 0 = no 1-trade/day cap (same symbol may trade multiple times).
MAX_ENTRIES_PER_DAY=0
MAX_OPEN_POSITIONS=1
ROBINHOOD_LIVE=0

# Aspiration only (days to 2x starting cash). Not a promotion gate.
# 365 is aggressive; values under 90 are treated as overfitting bait.
GOAL_DOUBLE_DAYS=365

# Optional shared secret for POST /agent/* and research writes. If unset, open on LAN.
# AGENT_TOKEN=

# Alpaca PAPER only. Live https://api.alpaca.markets is refused.
# ALPACA_LIVE=0
# Paper broker POSTs default on for paper:daily (moves the Alpaca paper account).
# Opt out: PAPER_BROKER_ORDERS=false  (or ALPACA_SUBMIT_PAPER=0)
# PAPER_BROKER_ORDERS=true
# ALPACA_SUBMIT_PAPER=1
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Rithmic Protocol API — stub only in this repo (no live futures orders).
# Live ES/NQ belongs in wstrat_candlemaster Python runtime, not NinjaTrader.
# RITHMIC_USER=
# RITHMIC_PASSWORD=
# RITHMIC_SYSTEM_NAME=Rithmic Test
# RITHMIC_APP_NAME=stock_market
# RITHMIC_APP_VERSION=
# RITHMIC_URL=rituz00100.rithmic.com:443
