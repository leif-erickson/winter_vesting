# backend/.env
DB_USER=user
DB_HOST=localhost
DB_NAME=portfolio_db
DB_PASSWORD=password
DB_PORT=5432
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
BINANCE_API_KEY=your_binance_key
BINANCE_SECRET=your_binance_secret

# Paper day-trading (no Robinhood keys — live is out of band via MCP)
DAYTRADE_UNIVERSE=SOFI,BRK.B,TSLA,AMZN,ARKK,MSFT,NVDA,PLTR
PAPER_CASH=100
MAX_POSITION_PCT=0.25
ROBINHOOD_LIVE=0

# Alpaca PAPER only. Live https://api.alpaca.markets is refused.
# ALPACA_LIVE=0
# ALPACA_SUBMIT_PAPER=0
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Rithmic Protocol API — stub only in this repo (no live futures orders).
# Live ES/NQ belongs in wstrat_candlemaster Python runtime, not NinjaTrader.
# RITHMIC_USER=
# RITHMIC_PASSWORD=
# RITHMIC_SYSTEM_NAME=Rithmic Test
# RITHMIC_APP_NAME=stock_market
# RITHMIC_APP_VERSION=
# RITHMIC_URL=rituz00100.rithmic.com:443
